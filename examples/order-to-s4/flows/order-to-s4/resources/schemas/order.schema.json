{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.oiw.dev/order.schema.json",
  "title": "Customer Order",
  "type": "object",
  "required": ["orderId", "customerId", "region", "items"],
  "properties": {
    "orderId": {"type": "string", "minLength": 1},
    "customerId": {"type": "string", "minLength": 1},
    "region": {"type": "string", "enum": ["EU", "NA", "APAC", "GLOBAL"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
