<edmx:Edmx xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" Version="1.0">
<edmx:DataServices xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" m:DataServiceVersion="2.0">
<Schema xmlns="http://schemas.microsoft.com/ado/2008/09/edm" Namespace="com.sap.hci.api">
<EntityType Name="LogFileArchive" m:HasStream="true">
<Key>
<PropertyRef Name="Scope"/>
<PropertyRef Name="LogFileType"/>
<PropertyRef Name="NodeScope"/>
</Key>
<Property Name="Scope" Type="Edm.String" Nullable="false"/>
<Property Name="LogFileType" Type="Edm.String" Nullable="false"/>
<Property Name="NodeScope" Type="Edm.String" Nullable="false"/>
<Property Name="ContentType" Type="Edm.String" Nullable="true"/>
</EntityType>
<EntityType Name="LogFile" m:HasStream="true">
<Key>
<PropertyRef Name="Name"/>
<PropertyRef Name="Application"/>
</Key>
<Property Name="Name" Type="Edm.String" Nullable="false"/>
<Property Name="Application" Type="Edm.String" Nullable="false"/>
<Property Name="LastModified" Type="Edm.DateTimeOffset" Nullable="true"/>
<Property Name="ContentType" Type="Edm.String" Nullable="true"/>
<Property Name="LogFileType" Type="Edm.String" Nullable="true"/>
<Property Name="NodeScope" Type="Edm.String" Nullable="true"/>
<Property Name="Size" Type="Edm.Int64" Nullable="true"/>
</EntityType>
<EntityContainer Name="DefaultContainer" m:IsDefaultEntityContainer="true">
<EntitySet Name="LogFileArchives" EntityType="com.sap.hci.api.LogFileArchive"/>
<EntitySet Name="LogFiles" EntityType="com.sap.hci.api.LogFile"/>
</EntityContainer>
</Schema>
</edmx:DataServices>
</edmx:Edmx>