# OIW CLI image — Phase 0/1 Python prototype.
# Spec ref: §18.1 (Docker Compose). See ADR-PY-001 for the language deviation.
FROM python:3.12-slim

WORKDIR /workspace

# System deps for lxml
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxml2 libxslt1.1 git \
    && rm -rf /var/lib/apt/lists/*

# Install the CLI in editable mode (mounts the repo at /workspace)
COPY apps/cli /workspace/apps/cli
COPY packages /workspace/packages
RUN pip install --no-cache-dir -e /workspace/apps/cli

ENTRYPOINT ["oiw"]
