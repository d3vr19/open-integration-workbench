# OIW Server — FastAPI prototype image.
# Spec ref: §18.1 (Docker Compose). See ADR-PY-002 for the deviation.
FROM python:3.12-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        libxml2 libxslt1.1 git \
    && rm -rf /var/lib/apt/lists/*

# Install CLI + server
COPY apps/cli /workspace/apps/cli
COPY packages /workspace/packages
COPY apps/server-python-prototype /workspace/apps/server-python-prototype
RUN pip install --no-cache-dir -e /workspace/apps/cli \
    && pip install --no-cache-dir -e /workspace/apps/server-python-prototype

ENV OIW_WORKSPACE=/workspace/examples
EXPOSE 8000

CMD ["uvicorn", "oiw_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
