{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.oiw.dev/flow-test/v1alpha1.json",
  "title": "FlowTest",
  "description": "Test definition IR. Spec §7.4.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "oiw.dev/v1alpha1" },
    "kind": { "type": "string", "const": "FlowTest" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["flow", "input", "assertions"],
      "additionalProperties": false,
      "properties": {
        "flow": { "type": "string", "description": "Flow ID under test." },
        "input": {
          "type": "object",
          "required": ["entrypoint"],
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string" },
            "bodyFile": { "type": "string", "description": "Relative path to fixture file." },
            "bodyInline": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "mocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "respond"],
            "additionalProperties": false,
            "properties": {
              "target": { "type": "string", "description": "Node ID to mock." },
              "respond": {
                "type": "object",
                "required": ["status"],
                "additionalProperties": false,
                "properties": {
                  "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "body": { "type": "string" },
                  "bodyFile": { "type": "string" },
                  "headers": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Assertion" }
        }
      }
    }
  },
  "$defs": {
    "Assertion": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "node.executed",
            "node.not-executed",
            "outbound.request",
            "exchange.status",
            "header.equals",
            "property.equals",
            "body.contains",
            "body.matches-json-path",
            "body.matches-xml-path"
          ]
        },
        "node": { "type": "string" },
        "target": { "type": "string" },
        "equals": {},
        "contains": { "type": "string" },
        "path": { "type": "string" },
        "bodyMatchesXml": { "type": "string" },
        "bodyMatchesJson": { "type": "string" },
        "name": { "type": "string" }
      }
    }
  }
}
