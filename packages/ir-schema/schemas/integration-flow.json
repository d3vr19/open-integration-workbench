{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.oiw.dev/flow/v1alpha1.json",
  "title": "IntegrationFlow",
  "description": "OIW canonical integration-flow IR. Spec §7.2. Semantics only; visual layout lives in diagram.json.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "oiw.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "IntegrationFlow"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "integer", "minimum": 1 },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "generatedBy": {
          "type": "object",
          "description": "Provenance for AI-generated nodes. Spec §7.3 rule 8.",
          "additionalProperties": false,
          "properties": {
            "agent": { "type": "string" },
            "model": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["entrypoints", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Entrypoint" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FlowNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/FlowEdge" }
        },
        "errorHandling": { "$ref": "#/$defs/ErrorHandling" },
        "extensions": {
          "type": "object",
          "description": "Lossless extension block. Unknown imported data goes here; never silently dropped. Spec §7.3 rule 3.",
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "Entrypoint": {
      "type": "object",
      "required": ["id", "type", "config"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$" },
        "type": {
          "type": "string",
          "enum": ["sender.http", "sender.timer", "sender.jms", "sender.sftp", "sender.processdirect"]
        },
        "config": { "type": "object" },
        "fidelity": { "$ref": "#/$defs/Fidelity" }
      }
    },
    "FlowNode": {
      "type": "object",
      "required": ["id", "type", "config"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$" },
        "type": {
          "type": "string",
          "description": "Step type identifier. Must match a registered plugin. Spec §9.4.",
          "enum": [
            "validator.json-schema",
            "modifier.content",
            "script.groovy",
            "transform.xslt",
            "router.content-based",
            "filter",
            "converter.json-to-xml",
            "converter.xml-to-json",
            "encoder.base64",
            "splitter.general",
            "gather",
            "receiver.http",
            "receiver.odata-v4",
            "receiver.sftp",
            "receiver.processdirect",
            "receiver.jdbc",
            "subprocess.exception",
            "subprocess.local",
            "request-reply",
            "datastore.write",
            "datastore.read",
            "variables.write",
            "log.message"
          ]
        },
        "config": { "type": "object" },
        "fidelity": { "$ref": "#/$defs/Fidelity" }
      }
    },
    "FlowEdge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "condition": {
          "type": "string",
          "description": "Condition ID for router branches. Spec §7.2 route-by-region example."
        }
      }
    },
    "Fidelity": {
      "type": "string",
      "description": "Spec §4.3 Explicit Fidelity.",
      "enum": ["authoring-only", "simulated", "compatible-subset", "tenant-required", "unsupported"]
    },
    "ErrorHandling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultExceptionSubprocess": {
          "type": "object",
          "required": ["steps"],
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "array",
              "items": { "$ref": "#/$defs/FlowNode" }
            }
          }
        }
      }
    }
  }
}
