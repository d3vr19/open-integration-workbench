{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.oiw.dev/project/v1alpha1.json",
  "title": "IntegrationProject",
  "description": "OIW project manifest. Spec §7.1.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "oiw.dev/v1alpha1",
      "description": "IR schema version. Pinned."
    },
    "kind": {
      "type": "string",
      "const": "IntegrationProject"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "created"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Stable project identifier (lowercase kebab-case)."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "created": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "maxLength": 2000 },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["package", "targetProfiles", "minimumCompilerVersion"],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "description": "Relative path to package manifest (package.yaml)."
        },
        "targetProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Target profiles this project can compile for, e.g. sap-cloud-integration-2026-07."
        },
        "minimumCompilerVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "secretProvider": {
          "type": "string",
          "enum": ["local-keyring", "env", "vault", "external"],
          "default": "local-keyring"
        },
        "emg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "confidentialityScope": {
              "type": "string",
              "enum": ["project-private", "tenant-private", "organization"],
              "default": "project-private"
            }
          }
        }
      }
    }
  }
}
