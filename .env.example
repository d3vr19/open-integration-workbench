# Environment variables for OIW local stack.
# Spec ref: §18.5 (Environment Variables).
# Copy to .env and fill in real values.

DB_PASSWORD=oiw-dev
MINIO_ROOT_USER=oiw
MINIO_ROOT_PASSWORD=oiw-dev

# LLM provider keys (only needed in Phase 3+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
LLM_PROVIDER=anthropic

# Team-mode Gitea
GITEA_ADMIN_USER=oiw-admin
GITEA_ADMIN_PASSWORD=change-me

# JWT for auth (team mode)
JWT_SECRET=change-me-to-a-long-random-string

OIW_MODE=local  # local | team

# Tenant connectivity (Phase 4+)
GITHUB_TOKEN=
GITLAB_TOKEN=
DEV_TENANT_URL=
DEV_TOKEN_URL=
DEV_CLIENT_ID=
