# Environment variables for OIW local stack.
# Spec ref: §18.5 (Environment Variables).
# Copy to .env and fill in real values.

DB_PASSWORD=oiw-dev
MINIO_ROOT_USER=oiw
MINIO_ROOT_PASSWORD=oiw-dev

# LLM provider keys (only needed in Phase 3+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
LLM_PROVIDER=anthropic

# Team-mode Gitea
GITEA_ADMIN_USER=oiw-admin
GITEA_ADMIN_PASSWORD=change-me

# JWT for auth (team mode)
JWT_SECRET=change-me-to-a-long-random-string

OIW_MODE=local  # local | team

# Tenant connectivity (Phase 4+)
GITHUB_TOKEN=
GITLAB_TOKEN=
DEV_TENANT_URL=
DEV_TOKEN_URL=
DEV_CLIENT_ID=

# ---------------------------------------------------------------------------
# WP-08 Track 0 — BTP Tenant Smoke (read-only, GET-only)
# ---------------------------------------------------------------------------
# Set OIW_USE_REAL_TENANT=1 to make `oiw tenant *` and `build_tenant_adapter()`
# use the real SapCiTenantAdapter instead of the in-process mock. CI must
# NEVER set this (per WP-08 §10 "What Not To Do").
#
# OIW_TENANT_URL  : the Cloud Integration OData API root, e.g.
#                   https://<tenant>.it-cpi021.cfapps.<region>.hana.ondemand.com/api/v1
# OIW_TENANT_USER : S-user id (e.g. S0026012658) for HTTP Basic auth
# OIW_TENANT_PASSWORD : the S-user password
#
# Alternative env-var names accepted by SapCiTenantAdapter (when an
# environment profile has `auth.credentialRef: <ref>`):
#   OIW_CRED_<REF>_USERNAME     where <REF> is the uppercased, alnum-only ref
#   OIW_CRED_<REF>_PASSWORD
# These are the WP-08 T0-001 documented convention for OAuth2 client-credentials
# service-key auth; Basic auth with S-user is the simpler read-only path.
OIW_USE_REAL_TENANT=
OIW_TENANT_URL=
OIW_TENANT_USER=
OIW_TENANT_PASSWORD=
